<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>タスク_予定表</AssemblyName>
    <RootNamespace>TaskScheduleTable</RootNamespace>
    <Version>2.7.0</Version>
    <AssemblyVersion>2.7.0.0</AssemblyVersion>
    <FileVersion>2.7.0.0</FileVersion>
    <Product>タスク・予定表</Product>
    <Description>デスクトップ用タスク・予定表</Description>
    <Authors>Don</Authors>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <Utf8Output>true</Utf8Output>
    <ApplicationIcon>Assets\TaskScheduleTable.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <None Include="Voice\**\*.wav" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <Target Name="GenerateApplicationIcon" BeforeTargets="CoreCompile">
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -Command &quot;$parts = Get-ChildItem '$(MSBuildProjectDirectory)\Assets\IconBase64\part*.txt' | Sort-Object Name; $b64 = ($parts | ForEach-Object { Get-Content $_.FullName -Raw }) -join ''; [IO.File]::WriteAllBytes('$(MSBuildProjectDirectory)\Assets\TaskScheduleTable.ico', [Convert]::FromBase64String($b64))&quot;" />
  </Target>
</Project>
