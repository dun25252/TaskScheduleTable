<Window x:Class="TaskScheduleTable.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="タスク・予定表"
        Width="760" Height="390" MinWidth="400" MinHeight="250"
        WindowStyle="None" ResizeMode="CanResize" AllowsTransparency="False"
        Background="#000000" Foreground="#00FF66" FontFamily="Yu Gothic UI"
        TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <SolidColorBrush x:Key="Green" Color="#00FF66"/>
        <SolidColorBrush x:Key="DimGreen" Color="#008D3B"/>
        <SolidColorBrush x:Key="ChromeFillBrush" Color="#000000"/>
        <SolidColorBrush x:Key="PanelFillBrush" Color="#000000"/>
        <SolidColorBrush x:Key="HeaderFillBrush" Color="#000000"/>
        <SolidColorBrush x:Key="ButtonFillBrush" Color="#050505"/>
        <SolidColorBrush x:Key="RowFillBrush" Color="#000000"/>
        <DropShadowEffect x:Key="TextHaloEffect" Color="#000000" ShadowDepth="0" BlurRadius="3.2" Opacity="1"/>

        <Style x:Key="ReadableTextStyle" TargetType="TextBlock">
            <Setter Property="Effect" Value="{StaticResource TextHaloEffect}"/>
        </Style>

        <Style TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource Green}"/>
            <Setter Property="Background" Value="{DynamicResource ButtonFillBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Green}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Margin" Value="3"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="MinHeight" Value="30"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="2" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"
                                              Effect="{StaticResource TextHaloEffect}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2D003311"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#50006622"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.42"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Foreground" Value="{StaticResource Green}"/>
            <Setter Property="Background" Value="#F0050505"/>
            <Setter Property="BorderBrush" Value="{StaticResource Green}"/>
            <Setter Property="CaretBrush" Value="{StaticResource Green}"/>
            <Setter Property="Padding" Value="6"/>
        </Style>

        <Style TargetType="Slider">
            <Setter Property="Foreground" Value="{StaticResource Green}"/>
        </Style>

        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="#000000"/>
            <Setter Property="Foreground" Value="{StaticResource Green}"/>
            <Setter Property="Width" Value="11"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Border Background="#000000" BorderBrush="#004A20" BorderThickness="1,0,0,0">
                            <Track x:Name="PART_Track" Orientation="{TemplateBinding Orientation}" IsDirectionReversed="True" Focusable="False">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="{x:Static ScrollBar.PageUpCommand}" Opacity="0" Focusable="False"/>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb MinHeight="24">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Background="#153D25" BorderBrush="#00FF66" BorderThickness="1" CornerRadius="2" Margin="1"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="{x:Static ScrollBar.PageDownCommand}" Opacity="0" Focusable="False"/>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border BorderBrush="{StaticResource Green}" BorderThickness="1" Background="#000000" ClipToBounds="True">
        <Grid x:Name="RootGrid" ClipToBounds="True">
            <Grid.RowDefinitions>
                <RowDefinition x:Name="TitleRow" Height="38"/>
                <RowDefinition Height="*"/>
                <RowDefinition x:Name="StatusRow" Height="29"/>
            </Grid.RowDefinitions>

            <Grid Grid.RowSpan="3" IsHitTestVisible="False" ClipToBounds="True">
                <Border Background="#000000"/>
                <Image x:Name="BackgroundImage" Stretch="UniformToFill" Opacity="0"/>
                <Border x:Name="BackgroundShade" Background="#000000" Opacity="0"/>
            </Grid>

            <Border x:Name="TitleChrome" Grid.Row="0" Background="{DynamicResource ChromeFillBrush}" BorderBrush="{StaticResource Green}" BorderThickness="0,0,0,1">
                <Grid x:Name="TitleBar" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="TitleText" Style="{StaticResource ReadableTextStyle}" Text="タスク・予定表" VerticalAlignment="Center" Margin="10,0,4,0"
                               FontWeight="SemiBold" Foreground="{StaticResource Green}" TextTrimming="CharacterEllipsis"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="LockButton" Content="位置固定: OFF" Click="LockButton_Click" MinWidth="92"/>
                        <Button x:Name="TopmostButton" Content="最前面: OFF" Click="TopmostButton_Click" MinWidth="92"/>
                        <Button x:Name="MinimizeButton" Content="―" Click="MinimizeButton_Click" Width="34" Padding="2"/>
                        <Button x:Name="MaximizeButton" Content="□" Click="MaximizeButton_Click" Width="34" Padding="2"/>
                        <Button x:Name="CloseButton" Content="×" Click="CloseButton_Click" Width="34" Padding="2" Margin="3,3,4,3"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid x:Name="ContentGrid" Grid.Row="1" Margin="7">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="LeftColumn" Width="155"/>
                    <ColumnDefinition Width="7"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border x:Name="LeftPanel" Grid.Column="0" Background="{DynamicResource PanelFillBrush}" BorderBrush="{StaticResource Green}" BorderThickness="1" Padding="5">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                            <Button x:Name="AddButton" Content="追加" Click="AddButton_Click"/>
                            <Button x:Name="EditButton" Content="編集" Click="EditButton_Click"/>
                            <Button x:Name="DeleteButton" Content="削除" Click="DeleteButton_Click"/>
                            <Button x:Name="FontUpButton" Content="文字を大きくする" Click="FontUpButton_Click"/>
                            <Button x:Name="FontDownButton" Content="文字を小さくする" Click="FontDownButton_Click"/>
                            <Button x:Name="BackgroundButton" Content="背景" Click="BackgroundButton_Click"/>
                            <TextBlock x:Name="FontLabel" Style="{StaticResource ReadableTextStyle}" Text="文字サイズ: 13.0 pt" TextAlignment="Center" Margin="4,8,4,2"/>
                            <TextBlock x:Name="CtrlHint" Style="{StaticResource ReadableTextStyle}" Text="Ctrl + ホイールでも変更" Foreground="#00AA44" TextAlignment="Center" TextWrapping="Wrap" Margin="3" FontSize="9"/>
                        </StackPanel>
                    </ScrollViewer>
                </Border>

                <Border x:Name="TaskListPanel" Grid.Column="2" Background="{DynamicResource PanelFillBrush}" BorderBrush="{StaticResource Green}" BorderThickness="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition x:Name="HeaderRow" Height="34"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Border x:Name="TaskHeaderPanel" Grid.Row="0" Background="{DynamicResource HeaderFillBrush}" BorderBrush="{StaticResource Green}" BorderThickness="0,0,0,1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition x:Name="HeaderUrlColumn" Width="54"/>
                                    <ColumnDefinition x:Name="HeaderDeadlineColumn" Width="96"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="UrlHeader" Style="{StaticResource ReadableTextStyle}" Grid.Column="0" Text="URL" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <TextBlock x:Name="DeadlineHeader" Style="{StaticResource ReadableTextStyle}" Grid.Column="1" Text="期限日" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <TextBlock x:Name="TaskTitleHeader" Style="{StaticResource ReadableTextStyle}" Grid.Column="2" Text="予定名 or タスク名" HorizontalAlignment="Center" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                            </Grid>
                        </Border>
                        <ScrollViewer x:Name="TaskScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                      PanningMode="VerticalOnly" CanContentScroll="False" Background="Transparent" PreviewMouseWheel="TaskScroll_PreviewMouseWheel">
                            <StackPanel x:Name="TaskPanel" Background="Transparent"/>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>

            <Border x:Name="StatusChrome" Grid.Row="2" Background="{DynamicResource ChromeFillBrush}" BorderBrush="{StaticResource Green}" BorderThickness="0,1,0,0">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock x:Name="StatusText" Style="{StaticResource ReadableTextStyle}" Grid.Column="0" Text="デスクトップ用タスク・予定表" VerticalAlignment="Center" Margin="8,0" TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="CountText" Style="{StaticResource ReadableTextStyle}" Grid.Column="1" Text="0 件" Foreground="#00AA44" VerticalAlignment="Center" Margin="8,0"/>
                </Grid>
            </Border>

            <Popup x:Name="UrlPopup" Placement="Right" StaysOpen="False" AllowsTransparency="True">
                <Border Background="#F5000000" BorderBrush="{StaticResource Green}" BorderThickness="1" Padding="8" Width="310">
                    <StackPanel>
                        <TextBlock Text="URL" Margin="3"/>
                        <TextBox x:Name="UrlPopupText" Margin="3"/>
                        <Button x:Name="UrlOpenButton" Content="URLを開く" Click="UrlOpenButton_Click"/>
                        <Button x:Name="UrlSaveButton" Content="URLを挿入 / 変更" Click="UrlSaveButton_Click"/>
                        <Button x:Name="UrlDisableButton" Content="URLをなしに設定する" Click="UrlDisableButton_Click"/>
                        <Button x:Name="UrlDeleteButton" Content="URLを削除" Click="UrlDeleteButton_Click"/>
                    </StackPanel>
                </Border>
            </Popup>

            <Popup x:Name="BackgroundPopup" Placement="Right" StaysOpen="False" AllowsTransparency="True">
                <Border Background="#F5000000" BorderBrush="{StaticResource Green}" BorderThickness="1" Padding="10" Width="310">
                    <StackPanel>
                        <TextBlock Text="背景画像" FontWeight="SemiBold" Margin="4"/>
                        <Button Content="画像を選択" Click="BackgroundChoose_Click"/>
                        <Button Content="背景画像をなしにする" Click="BackgroundClear_Click"/>
                        <TextBlock Text="画像の透明度" Margin="4,10,4,0"/>
                        <DockPanel Margin="4">
                            <TextBlock x:Name="BackgroundOpacityLabel" DockPanel.Dock="Right" Width="52" TextAlignment="Right" VerticalAlignment="Center"/>
                            <Slider x:Name="BackgroundOpacitySlider" Minimum="0" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="False"
                                    ValueChanged="BackgroundOpacitySlider_ValueChanged"/>
                        </DockPanel>
                        <TextBlock Text="文字背景の濃さ" Margin="4,10,4,0" Effect="{StaticResource TextHaloEffect}"/>
                        <DockPanel Margin="4">
                            <TextBlock x:Name="ReadabilityOpacityLabel" DockPanel.Dock="Right" Width="52" TextAlignment="Right" VerticalAlignment="Center"
                                       Effect="{StaticResource TextHaloEffect}"/>
                            <Slider x:Name="ReadabilityOpacitySlider" Minimum="0" Maximum="70" TickFrequency="1" IsSnapToTickEnabled="False"
                                    ValueChanged="ReadabilityOpacitySlider_ValueChanged"/>
                        </DockPanel>
                        <TextBlock Text="背景100%でも文字の後ろだけ黒くできます。0%なら写真をそのまま表示します。"
                                   Foreground="#00CC55" TextWrapping="Wrap" Margin="4,2,4,6" FontSize="10"
                                   Effect="{StaticResource TextHaloEffect}"/>
                        <TextBlock Text="選んだ画像はアプリ用フォルダーへコピーして保存します。" Foreground="#00AA44" TextWrapping="Wrap" Margin="4,8,4,2" FontSize="10"
                                   Effect="{StaticResource TextHaloEffect}"/>
                    </StackPanel>
                </Border>
            </Popup>
        </Grid>
    </Border>
</Window>
